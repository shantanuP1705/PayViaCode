# Root Gitignore for PayViaCode workspace

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store

# IDE/editor
.vscode/
.idea/
*.iml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node/Next.js
node_modules/
.next/
out/
.vercel/
.svelte-kit/
.swc/

# PNPM store
.pnpm-store/

# Coverage
coverage/

# Dist/build outputs
build/
dist/

# Java/Maven
PaymentSystem/target/
PaymentSystem/.idea/
PaymentSystem/.project
PaymentSystem/.classpath
PaymentSystem/.settings/

# Spring Boot local files
PaymentSystem/*.log

# Misc caches
**/.cache/
